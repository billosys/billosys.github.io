{% comment %} Shared site footer + the blog's theme-toggle behaviour script.
   The footer markup/CSS is shared with the marketing site (site-footer.liquid /
   _sass/_site-footer.scss). The script below is blog-only: it drives the nav's
   #themeToggle button and MUST stay here (the marketing footer has no toggle
   script — that one is inline in secondary.liquid). See slice 06. {% endcomment %}
{% include 'site-footer.liquid' %}

<script>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('themeToggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      localStorage.setItem('billo-theme', next);
    });
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function (e) {
      if (!localStorage.getItem('billo-theme')) root.setAttribute('data-theme', e.matches ? 'light' : 'dark');
    });
  })();
</script>
