---
title: Articles
description: Field notes on distributed systems, Erlang/OTP, and the infrastructure of correctness under contention.
permalink: /articles/
layout: blog-base.liquid
data:
  nav: latest
---
{% comment %} Blog landing — design 2a: featured lead → recent (full) → earlier (compact). {% endcomment %}
{% assign posts = collections.posts.pages %}
{% assign featured = posts[0] %}

<section class="featured">
  <span class="featured__eyebrow">Latest essay</span>
  <a href="/{{ featured.permalink }}" class="featured__title">{{ featured.title }}</a>
  {% if featured.description %}<p class="featured__dek">{{ featured.description }}</p>{% endif %}
  <div class="article-meta">
    <span>{{ featured.data.author | default: "Duncan McGreggor" }}</span>
    <span class="sep">&middot;</span>
    <span>{{ featured.published_date | date: "%b %d, %Y" }}</span>
    {% comment %} Safe reading-time (see archive.liquid): compute, override if data.minutes present. {% endcomment %}
    {% assign _words = featured.content | strip_html | split: " " | size %}
    {% assign _mins = _words | divided_by: 200 %}{% if _mins < 1 %}{% assign _mins = 1 %}{% endif %}
    {% for _kv in featured.data %}{% if _kv[0] == "minutes" %}{% assign _mins = _kv[1] %}{% endif %}{% endfor %}
    <span class="sep">&middot;</span><span>{{ _mins }} min</span>
    {% for tag in featured.tags %}<span class="hash">#{{ tag }}</span>{% endfor %}
  </div>
  <a href="/{{ featured.permalink }}" class="read-more">Read the essay <span>&rarr;</span></a>
</section>

<hr class="rule-strong" style="margin-block-start: var(--space-xl);">

<p class="section-label" style="display:block; margin-block-start: var(--space-l);">Recent</p>
<ul class="post-list">
  {% comment %} offset:1 + break (not `limit:4`): the liquid engine crashes on
     offset+limit > post count; break clamps safely as the archive grows. {% endcomment %}
  {% for post in posts offset:1 %}
  {% if forloop.index0 >= 4 %}{% break %}{% endif %}
  <li class="post-entry">
    <div class="article-meta">
      <span>{{ post.published_date | date: "%b %d, %Y" }}</span><span class="sep">&middot;</span>
      {% assign _words = post.content | strip_html | split: " " | size %}
      {% assign _mins = _words | divided_by: 200 %}{% if _mins < 1 %}{% assign _mins = 1 %}{% endif %}
      {% for _kv in post.data %}{% if _kv[0] == "minutes" %}{% assign _mins = _kv[1] %}{% endif %}{% endfor %}
      <span>{{ _mins }} min</span><span class="sep">&middot;</span>
      <span>{{ post.data.author | default: "Duncan McGreggor" }}</span>
    </div>
    <a href="/{{ post.permalink }}" class="post-entry__title">{{ post.title }}</a>
    {% if post.description %}<p class="post-entry__dek">{{ post.description }}</p>{% endif %}
    <div class="tag-chips">{% for tag in post.tags %}<a href="/tags/{{ tag }}/" class="tag-chip">{{ tag }}</a>{% endfor %}</div>
  </li>
  {% endfor %}
</ul>

<p class="section-label" style="display:block; margin-block-start: var(--space-l);">Earlier writing</p>
<div>
  {% for post in posts offset:5 %}
  <a href="/{{ post.permalink }}" class="post-compact">
    <span style="min-width: 0;">
      <span class="post-compact__title">{{ post.title }}</span>
      <span class="post-compact__meta">
        <span>{{ post.published_date | date: "%b %d, %Y" }}</span>
        {% for tag in post.tags %}<span class="sep">&middot;</span><span class="hash">#{{ tag }}</span>{% endfor %}
      </span>
    </span>
    {% assign _words = post.content | strip_html | split: " " | size %}
    {% assign _mins = _words | divided_by: 200 %}{% if _mins < 1 %}{% assign _mins = 1 %}{% endif %}
    {% for _kv in post.data %}{% if _kv[0] == "minutes" %}{% assign _mins = _kv[1] %}{% endif %}{% endfor %}
    <span class="post-compact__time">{{ _mins }} min</span>
  </a>
  {% endfor %}
</div>
<div class="list-more"><a href="/archive/">Browse the full archive &rarr;</a></div>
